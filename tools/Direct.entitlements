<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Direct download (tools/release-direct.sh): the store entitlements minus Sign in with Apple. Was: Store/TestFlight and tools/run-dev.sh builds: iCloud key-value sync, Sign in with Apple and the keychain group
     need a provisioning profile, so ad-hoc builds use tools/Local.entitlements. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key><true/>
	<key>com.apple.security.network.client</key><true/>
	
	<key>keychain-access-groups</key><array><string>$(AppIdentifierPrefix)com.sgjlee.tomatime</string></array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key><string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
</dict>
</plist>
